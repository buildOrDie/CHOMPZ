# Optional override. The public mainnet RPC is used when omitted.
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Required only for state-changing commands: npm run approve / npm run execute
# Never commit a funded key. Prefer a dedicated execution wallet with limited funds.
PRIVATE_KEY=

# approve.mjs
TOKEN=
AMOUNT=

# execute.mjs
ROUTE_FILE=./examples/route.example.json

# nft.mjs (optional)
TOKEN_ID=
